{
  "name": "garage-to-gigawatt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "staging:build": "tsc -b && vite build --mode staging --outDir staging --emptyOutDir",
    "staging": "vite preview --outDir staging --port 4173 --strictPort",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "play": "node tools/play.ts",
    "content:market": "node tools/market-csv-to-json.ts",
    "data:real": "node tools/data/real-market.ts",
    "release-check": "node tools/release-check.ts",
    "sim": "node tools/sim-runner.ts"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/public-sans": "^5.3.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5",
    "zzfx": "^1.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^24.13.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "happy-dom": "^20.14.5",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.2"
  }
}
